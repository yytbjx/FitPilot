# FitPilot 开发环境变量示例
# 复制为项目根目录 .env 后按本机情况修改；切勿提交真实密钥

# ---------- 应用 ----------
APP_NAME=FitPilot
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
# JWT（开发占位；生产务必更换）
JWT_SECRET=change-me-fitpilot-dev-secret-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------- 食谱优化 ----------
AGENT_USE_WORKER=false
# Redis Streams：最大重试次数 / pending 认领空闲毫秒
AGENT_QUEUE_MAX_RETRIES=3
AGENT_QUEUE_CLAIM_IDLE_MS=60000
# CORS：开发可用 *；生产请写具体前端源，逗号分隔
CORS_ORIGINS=*
MEAL_USE_ORTOOLS=true

# ---------- 数据库（Docker Compose 提供） ----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=fitpilot
POSTGRES_PASSWORD=fitpilot
POSTGRES_DB=fitpilot
DATABASE_URL=postgresql+asyncpg://fitpilot:fitpilot@127.0.0.1:5432/fitpilot

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- Qdrant（本机已有 Docker 容器，默认连宿主机） ----------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=fitpilot_knowledge
QDRANT_API_KEY=

# ---------- Ollama：按环节分模型（缓解 6GB 显存不足） ----------
# 本机已装示例：qwen2.5:0.5b / qwen2.5:1.5b / qwen3.5:4b / gemma3:4b / qwen2.5:7b
# 不建议默认加载 7B（易 OOM）；4B 仅在单独跑 RAG、且 Embedding 用 CPU 时使用
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 默认/回退（也作为 RAG 回退）
OLLAMA_MODEL=qwen2.5:1.5b
# RAG 知识问答生成：质量优先可改为 qwen3.5:4b（需保证 Embedding 在 CPU）
OLLAMA_MODEL_RAG=qwen2.5:1.5b
# LLM-as-judge / 结构化打分：用最小模型
OLLAMA_MODEL_JUDGE=qwen2.5:0.5b
# 查询改写 / 意图辅助（默认关闭 LLM，仅配置模型名备用）
OLLAMA_MODEL_REWRITE=qwen2.5:0.5b
OLLAMA_MODEL_CLASSIFY=qwen2.5:0.5b
OLLAMA_USE_LLM_REWRITE=false
OLLAMA_USE_LLM_CLASSIFY=false
# 请求结束后尽快卸载模型，释放显存（0=立刻；30s / 5m）
OLLAMA_KEEP_ALIVE=30s
OLLAMA_TIMEOUT_SECONDS=120

# ---------- 本地 Embedding / Reranker（与 Ollama 错峰） ----------
# 与 Ollama 同卡时务必 cpu，避免抢显存；入库大批量时可临时改 cuda
# EMBEDDING_MODEL=
# 留空则自动使用 <项目根>/models/bge-small-zh-v1.5 或 HF 名 BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# RERANKER_MODEL=
# 留空则自动使用 <项目根>/models/bge-reranker-large 或 bge-reranker-base
RERANKER_DEVICE=cpu
# 可选：换更小精排模型；或直接跳过精排加速（略降引用精确度）
# RERANKER_MODEL_NAME=BAAI/bge-reranker-base
# RAG_SKIP_RERANK=true
# 单次检索 Top-K
RAG_TOP_K=8
RAG_RERANK_TOP_K=4
# 入库分块：auto|fixed|heading|parent_child|faq_qa|clause|table_row
# RAG_CHUNK_STRATEGY=auto
# HuggingFace 镜像（可选）；无本地权重时可设 RAG_OFFLINE=1，用哈希向量+BM25 联调
HF_ENDPOINT=https://hf-mirror.com
# RAG_OFFLINE=1
# 加速提示：1) RAG_SKIP_RERANK=true  2) 小参数 Ollama  3) Embedding=cpu 与 Ollama 错峰  4) KEEP_ALIVE=30s

# ---------- 多格式入库截断 / OCR（可选） ----------
# RAG_CSV_MAX_ROWS=300
# RAG_JSON_MAX_ITEMS=200
# RAG_JSON_MAX_BYTES=8388608
# RAG_PDF_MAX_PAGES=
# RAG_SHEET_MAX_ROWS=200
# RAG_SHEET_MAX_SHEETS=10
# RAG_ENABLE_OCR=false
# RAG_OCR_LANG=chi_sim+eng


# ---------- Token 预算监控（实时累计；超过阈值自动停止） ----------
# TOKEN_BUDGET：会话/任务级别总预算（prompt + completion）
TOKEN_BUDGET=100000
# 超过预算的该比例即熔断停止（0.5 = 50%）
TOKEN_STOP_RATIO=0.5
# 多租户分桶：每用户 Token 预算 / 全局兜底预算
TOKEN_BUDGET_PER_USER=100000
TOKEN_BUDGET_GLOBAL=1000000

# ---------- Agent 任务可靠性（迭代 2） ----------
# 单任务执行超时（秒），超时标记 failed(reason=timeout)
AGENT_TASK_TIMEOUT_SECONDS=600
# queued 排队超时（秒）/ running 最长存活（秒，应 >= 任务超时）
AGENT_STALE_TASK_SECONDS=300
AGENT_RUNNING_TASK_MAX_SECONDS=1800
# 每用户并发任务上限（queued/pending/running）
AGENT_MAX_CONCURRENT_TASKS_PER_USER=3
# reaper 扫描周期（秒）/ TTL 清理周期（秒）/ 单批删除行数
AGENT_REAPER_INTERVAL_SECONDS=30
AGENT_CLEANUP_INTERVAL_SECONDS=3600
AGENT_CLEANUP_BATCH_SIZE=500
# 保留期：LangGraph 检查点（天）/ 任务事件（天）/ 未确认记忆提议（天）
AGENT_RETENTION_DAYS=30
AGENT_EVENT_RETENTION_DAYS=7
MEMORY_PROPOSAL_TTL_DAYS=30

# ---------- 安全运营 ----------
# 登录/注册每 IP 每分钟限流
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---------- 可观测性（可选） ----------
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOG_LEVEL=INFO

# ---------- docker-compose.prod.yml 专用 ----------
# 生产部署必填（compose 中无默认值，缺失即拒绝启动）：
# GF_SECURITY_ADMIN_PASSWORD   Grafana 管理员密码（请使用强随机值）
GF_SECURITY_ADMIN_PASSWORD=
# 生产 Postgres 密码复用上方 POSTGRES_PASSWORD；compose 要求必须显式设置且非空
# 可选覆盖（默认值见 docker-compose.prod.yml）：
# POSTGRES_USER=fitpilot
# POSTGRES_DB=fitpilot
# 前端对外端口（默认 8080）
# FRONTEND_PORT=8080
# 生产部署提醒：APP_ENV=production 时禁止使用弱 JWT_SECRET 与 CORS_ORIGINS=*，
# 请设置强 JWT_SECRET 并将 CORS_ORIGINS 改为具体前端源（如 http://<服务器IP>:8080）
