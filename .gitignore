# FitPilot 仓库忽略规则

# GitHub Desktop 误建的嵌套空仓库（勿提交）
FitPilot/

# 环境与密钥
.env
.env.local
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
backend/.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/

# Node / 前端
node_modules/
frontend/dist/
frontend/.vite/

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini

# 日志与临时
*.log
.tmp/
_docx_extract/
_doc.zip
_doc_text.txt
_doc_text_utf8.txt

# 模型缓存（体积大，本地自行下载；仅忽略仓库根目录 /models，勿误伤 backend/app/models ORM）
.cache/
/models/
**/huggingface/

# 数据卷备份
*.dump

# 知识索引版本元数据（本地生成）
knowledge_base/index_versions.jsonl
knowledge_base/active_index_version.json
knowledge_base/bm25_index.json
evals/reports/

# 第三方参考项目与数据集（体积大，本地保留但不入库）
_refs/
例子或数据/

# 前端构建缓存
*.tsbuildinfo

# docx 提取中间产物
_enhancement_plan_extract.txt

# 空壳评估数据目录（已废弃）
eval_datasets/
